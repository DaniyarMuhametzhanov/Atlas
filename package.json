{
  "name": "atlas",
  "version": "2.0.0-alpha",
  "private": true,
  "type": "module",
  "description": "Атлас-путеводитель 2.0",
  "scripts": {
    "extract": "tsx scripts/extract-legacy.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:map": "tsx scripts/build-map.ts",
    "fetch:glyphs": "tsx scripts/fetch-glyphs.ts",
    "fetch:commons": "tsx scripts/fetch-commons.ts",
    "build:images": "tsx scripts/build-images.ts",
    "data": "npm run extract && npm run fetch:glyphs && npm run build:map && npm run build:history",
    "build:history": "tsx scripts/build-history.ts",
    "build:booklets": "tsx scripts/build-booklets.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "all-the-cities": "^3.1.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "i18n-iso-countries": "^7.14.0",
    "mapshaper": "^0.7.100",
    "polylabel": "^2.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "topojson-server": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "world-atlas": "^2.0.2",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "maplibre-gl": "^5.24.0",
    "photoswipe": "^5.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "zustand": "^4.5.7"
  }
}
